<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/shk_widget_bg">
    <TextView android:id="@+id/shk_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="THE BOARD" android:textColor="#FF9D86FF" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" android:maxLines="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="JOBS DOWN" android:textColor="#FFA39CC0" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/shk_jobs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#8212;" android:textColor="#FF4DE2FF" android:textSize="26sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BOARD ON" android:textColor="#FFA39CC0" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/shk_board" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#8212;" android:textColor="#FFECE9F5" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.7" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="THE CALL" android:textColor="#FFA39CC0" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/shk_call" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#8212;" android:textColor="#FFFF4DD2" android:textSize="26sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/shk_waves" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textColor="#FFECE9F5" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
    <TextView android:id="@+id/shk_last" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textColor="#FFA39CC0" android:textSize="11sp" android:maxLines="1" />
</LinearLayout>
