<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/shk_widget_bg">
    <TextView android:id="@+id/shk_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="SHADOW HOOK" android:textColor="#FF9D86FF" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" android:maxLines="1" />
    <TextView android:id="@+id/shk_big" android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center_vertical" android:text="&#8212;" android:textColor="#FF4DE2FF" android:textSize="46sp" android:textStyle="bold" android:maxLines="1" />
    <TextView android:id="@+id/shk_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textColor="#FFECE9F5" android:textSize="12sp" android:maxLines="1" />
    <TextView android:id="@+id/shk_line" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textColor="#FFA39CC0" android:textSize="11sp" android:maxLines="1" />
</LinearLayout>
